{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ (desk view)" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ (вид на стол)"
          }
        }
      }
    },
    "%lld fps" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld к/с"
          }
        }
      }
    },
    "%lld ms" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld мс"
          }
        }
      }
    },
    "4:3 instead of 16:9: if the camera delivers it from the same sensor, the hand gets more room at the bottom" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Формат 4:3 вместо 16:9: если камера даёт его с той же матрицы, руке больше места снизу"
          }
        }
      }
    },
    "Accessibility" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Универсальный доступ"
          }
        }
      }
    },
    "Allow" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разрешить"
          }
        }
      }
    },
    "Allow Access" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разрешить доступ"
          }
        }
      }
    },
    "Almost no difference" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разницы почти нет"
          }
        }
      }
    },
    "Always" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Всегда"
          }
        }
      }
    },
    "Any" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Любая"
          }
        }
      }
    },
    "At the bottom edge: raise your hand" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У нижнего края: поднимите руку выше"
          }
        }
      }
    },
    "At the far edge of the desk: move your hand toward you" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У дальнего края стола: придвиньте руку к себе"
          }
        }
      }
    },
    "At the left edge: move your hand to the right" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У левого края: сдвиньте руку правее"
          }
        }
      }
    },
    "At the near edge of the desk: move your hand away from you" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У ближнего края стола: сдвиньте руку от себя"
          }
        }
      }
    },
    "At the right edge: move your hand to the left" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У правого края: сдвиньте руку левее"
          }
        }
      }
    },
    "At the top edge: lower your hand" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У верхнего края: опустите руку ниже"
          }
        }
      }
    },
    "Average frame brightness and illuminance as estimated by the camera itself" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Средняя яркость кадра и освещённость по оценке самой камеры"
          }
        }
      }
    },
    "Bright strips along the screen edges light up your hand while gestures are on. “In the Dark”: they turn on when the frame gets dark and stay on until gestures are turned off" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Светлые полосы по краям экрана освещают руку, пока включены жесты. «В темноте»: загораются, когда кадр потемнел, и горят до выключения жестов"
          }
        }
      }
    },
    "Brighten dark frames for recognition" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Осветлять тёмный кадр для распознавания"
          }
        }
      }
    },
    "Brightening helps" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Осветление помогает"
          }
        }
      }
    },
    "Brightening helps: worth turning it on" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Осветление помогает: его стоит включить"
          }
        }
      }
    },
    "Brightening hurts" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Осветление мешает"
          }
        }
      }
    },
    "Brightening hurts: better turn it off" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Осветление мешает: лучше выключить"
          }
        }
      }
    },
    "Call with gesturing" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Созвон с жестикуляцией"
          }
        }
      }
    },
    "Camera" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Камера"
          }
        }
      }
    },
    "Camera is busy or unavailable" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Камера занята или недоступна"
          }
        }
      }
    },
    "Camera not found" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Камера не найдена"
          }
        }
      }
    },
    "Couldn't get frames from the camera" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось получить кадры с камеры"
          }
        }
      }
    },
    "Cursor" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Курсор"
          }
        }
      }
    },
    "Dark frames compared: %lld. The hand was found in %lld%% of them without brightening and in %lld%% with it; joints visible: %lld and %lld of 21." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Dark frames compared: %1$lld. The hand was found in %2$lld%% of them without brightening and in %3$lld%% with it; joints visible: %4$lld and %5$lld of 21."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тёмных кадров в сравнении: %lld. Рука нашлась без осветления в %lld%%, с ним в %lld%%; суставов видно %lld и %lld из 21."
          }
        }
      }
    },
    "Disabled" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "выключен"
          }
        }
