    "Flip horizontally" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отразить по горизонтали"
          }
        }
      }
    },
    "Flip vertically" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отразить по вертикали"
          }
        }
      }
    },
    "For when the other hand isn't in the frame. Off by default because a hand opening a pinch looks like this pose and starts scrolling by itself" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для случая, когда второй руки нет в кадре. Выключено, потому что кисть, разжимающая щипок, похожа на эту позу и включает прокрутку сама"
          }
        }
      }
    },
    "Frame area to the whole screen" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зона кадра на весь экран"
          }
        }
      }
    },
    "Frames are processed only on this Mac and never leave it." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кадры обрабатываются только на этом Mac и никуда не отправляются."
          }
        }
      }
    },
    "Gesture badge next to the cursor" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Значок жеста у курсора"
          }
        }
      }
    },
    "Gesture control (⌃⌥⌘G)" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Управление жестами (⌃⌥⌘G)"
          }
        }
      }
    },
    "Gesture log (⌃⌥⌘M false trigger, ⌃⌥⌘N miss)" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Журнал жестов (⌃⌥⌘M ложное, ⌃⌥⌘N пропуск)"
