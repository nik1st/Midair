    "Hand left the frame on the right" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Рука ушла за правый край кадра"
          }
        }
      }
    },
    "Hand lost mid-frame: turn your palm to the camera" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Рука потерялась в кадре: поверните ладонь к камере"
          }
        }
      }
    },
    "Hand lost: it's dark, add some light" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Рука потерялась: в кадре темно, добавьте света"
          }
        }
      }
    },
    "Hand out of frame" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Рука вне кадра"
          }
        }
      }
    },
    "Hands that enter the frame by accident (a mug, a phone, a conversation) do nothing until the palm holds still for half a second" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Руки, попавшие в кадр случайно (кружка, телефон, разговор), ничего не делают, пока ладонь не постоит на месте полсекунды"
          }
        }
      }
    },
    "Hold an open palm still to start" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Задержите открытую ладонь, чтобы начать"
          }
        }
      }
    },
    "Hold for a right-click or move your hand to drag" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Держите для правого клика или ведите руку, чтобы тащить"
          }
        }
      }
    },
    "Holding the drag: bring your pinching hand back" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Держу перетаскивание: верните руку со щипком"
